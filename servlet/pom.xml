<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.wildfly.clustering.examples</groupId>
		<artifactId>wildfly-clustering-examples</artifactId>
		<version>42.0.0.Final-SNAPSHOT</version>
	</parent>

	<artifactId>wildfly-clustering-examples-servlet</artifactId>
	<packaging>jar</packaging>

	<name>${project.repository.name}: Jakarta Servlet</name>

	<properties>
		<project.module.name>org.wildfly.clustering.examples.servlet</project.module.name>
		<arquillian.xml>arquillian-${test.container}.xml</arquillian.xml>
		<test.args/>
		<http.port.1>8080</http.port.1>
		<http.port.2>8081</http.port.2>
		<http.port.3>8082</http.port.3>
		<http.port.4>8083</http.port.4>
		<https.port.1>8443</https.port.1>
		<https.port.2>8444</https.port.2>
		<https.port.3>8445</https.port.3>
		<https.port.4>8446</https.port.4>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.hazelcast</groupId>
				<artifactId>hazelcast</artifactId>
				<version>5.7.0</version>
			</dependency>
			<dependency>
				<groupId>com.hazelcast</groupId>
				<artifactId>hazelcast-spring</artifactId>
				<version>5.7.0</version>
			</dependency>
			<dependency>
				<groupId>com.hazelcast.spring</groupId>
				<artifactId>hazelcast-spring-session</artifactId>
				<version>4.0.0</version>
			</dependency>
			<dependency>
				<groupId>org.assertj</groupId>
				<artifactId>assertj-bom</artifactId>
				<version>3.27.7</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.infinispan</groupId>
				<artifactId>infinispan-bom</artifactId>
				<version>16.2.3</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.wildfly.clustering</groupId>
				<artifactId>arquillian-glassfish-server-remote</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>fish.payara.arquillian</groupId>
				<artifactId>arquillian-payara-server-remote</artifactId>
				<version>4.0.alpha4</version>
			</dependency>
			<dependency>
				<groupId>io.lettuce</groupId>
				<artifactId>lettuce-core</artifactId>
				<version>7.8.0.RELEASE</version>
			</dependency>
			<dependency>
				<groupId>io.openliberty.arquillian</groupId>
				<artifactId>arquillian-liberty-remote-jakarta</artifactId>
				<version>3.0.0</version>
			</dependency>
			<dependency>
				<groupId>org.jboss.arquillian</groupId>
				<artifactId>arquillian-bom</artifactId>
				<version>1.10.2.Final</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.jboss.arquillian.container</groupId>
				<artifactId>arquillian-tomcat-remote-10</artifactId>
				<version>1.2.5.Final</version>
			</dependency>
			<dependency>
				<groupId>org.junit</groupId>
				<artifactId>junit-bom</artifactId>
				<version>6.1.3</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.springframework</groupId>
				<artifactId>spring-framework-bom</artifactId>
				<version>7.0.10</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.springframework.session</groupId>
				<artifactId>spring-session-bom</artifactId>
				<version>4.1.1</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.wildfly.arquillian</groupId>
				<artifactId>wildfly-arquillian-bom</artifactId>
				<version>5.1.0.Final</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.wildfly.clustering</groupId>
				<artifactId>wildfly-clustering-bom</artifactId>
				<version>12.0.2.Final</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>jakarta.servlet</groupId>
			<artifactId>jakarta.servlet-api</artifactId>
			<version>6.1.0</version>
			<scope>provided</scope>
		</dependency>

		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.jboss.arquillian.junit5</groupId>
			<artifactId>arquillian-junit5-container</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.wildfly.clustering</groupId>
			<artifactId>wildfly-clustering-arquillian</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.wildfly.clustering</groupId>
			<artifactId>wildfly-clustering-container-arquillian</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<id>default-copy-dependencies</id>
						<phase>process-test-resources</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.basedir}/target/lib</outputDirectory>
							<includeScope>runtime</includeScope>
							<stripVersion>true</stripVersion>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<configuration>
					<argLine>@{argLine} -Darquillian.xml=${arquillian.xml} -Dtest.resources=${project.build.outputDirectory} -Dtest.lib=${project.basedir}/target/lib ${test.args}</argLine>
				</configuration>
			</plugin>
		</plugins>
	</build>
	<profiles>
		<profile>
			<id>default</id>
			<activation>
				<property>
					<name>!test.spring</name>
				</property>
			</activation>
			<build>
				<resources>
					<resource>
						<directory>src/main/resources/default</directory>
						<includes>
							<include>*</include>
						</includes>
					</resource>
				</resources>
			</build>
		</profile>
		<profile>
			<id>skip</id>
			<activation>
				<property>
					<name>!test.container</name>
				</property>
			</activation>
			<properties>
				<skipITs>true</skipITs>
			</properties>
		</profile>
		<profile>
			<id>container</id>
			<activation>
				<property>
					<name>test.container</name>
				</property>
			</activation>
			<build>
				<resources>
					<resource>
						<directory>src/main/resources/${test.container}</directory>
						<includes>
							<include>*</include>
						</includes>
					</resource>
				</resources>
				<testResources>
					<testResource>
						<directory>src/test/resources</directory>
						<filtering>true</filtering>
						<includes>
							<include>${arquillian.xml}</include>
						</includes>
					</testResource>
				</testResources>
			</build>
		</profile>
		<profile>
			<id>glassfish</id>
			<activation>
				<property>
					<name>test.container</name>
					<value>glassfish</value>
				</property>
			</activation>
			<properties>
				<!-- Prevents container from attempting superfluous command that otherwise fails -->
				<container.args>-Dcom.sun.aas.productRoot=/opt/gfinstall</container.args>
			</properties>
			<dependencies>
				<dependency>
					<groupId>org.wildfly.clustering</groupId>
					<artifactId>arquillian-glassfish-server-remote</artifactId>
					<scope>test</scope>
				</dependency>
			</dependencies>
		</profile>
		<profile>
			<id>openliberty</id>
			<activation>
				<property>
					<name>test.container</name>
					<value>openliberty</value>
				</property>
			</activation>
			<properties>
				<test.args>-Dtest.trust-all-certs=true</test.args>
			</properties>
			<dependencies>
				<dependency>
					<groupId>io.openliberty.arquillian</groupId>
					<artifactId>arquillian-liberty-remote-jakarta</artifactId>
					<scope>test</scope>
				</dependency>
				<dependency>
					<groupId>com.hazelcast</groupId>
					<artifactId>hazelcast</artifactId>
				</dependency>
			</dependencies>
		</profile>
		<profile>
			<id>payara</id>
			<activation>
				<property>
					<name>test.container</name>
					<value>payara</value>
				</property>
			</activation>
			<dependencies>
				<dependency>
					<groupId>fish.payara.arquillian</groupId>
					<artifactId>arquillian-payara-server-remote</artifactId>
					<scope>test</scope>
				</dependency>
			</dependencies>
		</profile>
		<profile>
			<id>tomcat</id>
			<activation>
				<property>
					<name>test.container</name>
					<value>tomcat</value>
				</property>
			</activation>
			<dependencies>
				<dependency>
					<groupId>org.jboss.arquillian.container</groupId>
					<artifactId>arquillian-tomcat-remote-10</artifactId>
					<scope>test</scope>
				</dependency>
			</dependencies>
		</profile>
		<profile>
			<id>wildfly</id>
			<activation>
				<property>
					<name>test.container</name>
					<value>wildfly</value>
				</property>
			</activation>
			<properties>
				<management.port.1>9990</management.port.1>
				<management.port.2>9991</management.port.2>
				<management.port.3>9992</management.port.3>
				<management.port.4>9993</management.port.4>
			</properties>
			<dependencies>
				<dependency>
					<groupId>org.wildfly.arquillian</groupId>
					<artifactId>wildfly-arquillian-container-remote</artifactId>
					<scope>test</scope>
				</dependency>
			</dependencies>
		</profile>
		<!-- Spring profiles -->
		<profile>
			<id>spring</id>
			<activation>
				<property>
					<name>test.spring</name>
				</property>
			</activation>
			<dependencies>
				<dependency>
					<groupId>org.springframework</groupId>
					<artifactId>spring-context</artifactId>
				</dependency>
				<dependency>
					<groupId>org.springframework</groupId>
					<artifactId>spring-web</artifactId>
				</dependency>
				<dependency>
					<groupId>org.springframework.session</groupId>
					<artifactId>spring-session-core</artifactId>
				</dependency>
			</dependencies>
			<build>
				<resources>
					<resource>
						<directory>src/main/resources/spring</directory>
						<includes>
							<include>*</include>
						</includes>
					</resource>
					<resource>
						<directory>src/main/resources/spring/${test.spring}</directory>
						<includes>
							<include>*</include>
						</includes>
					</resource>
				</resources>
			</build>
		</profile>
		<profile>
			<id>hazelcast</id>
			<activation>
				<property>
					<name>test.spring</name>
					<value>hazelcast</value>
				</property>
			</activation>
			<dependencies>
				<dependency>
					<groupId>com.hazelcast</groupId>
					<artifactId>hazelcast-spring</artifactId>
				</dependency>
				<dependency>
					<groupId>com.hazelcast.spring</groupId>
					<artifactId>hazelcast-spring-session</artifactId>
				</dependency>
			</dependencies>
		</profile>
		<profile>
			<id>infinispan</id>
			<activation>
				<property>
					<name>test.spring</name>
					<value>infinispan</value>
				</property>
			</activation>
			<properties>
				<test.args>-Doci:image=quay.io/infinispan/server:latest -Doci:network-mode=host -Denv:USER=admin -Denv:PASS=changeme</test.args>
			</properties>
			<dependencies>
				<dependency>
					<groupId>org.infinispan</groupId>
					<artifactId>infinispan-spring7-remote</artifactId>
				</dependency>
			</dependencies>
		</profile>
		<profile>
			<id>redis</id>
			<activation>
				<property>
					<name>test.spring</name>
					<value>redis</value>
				</property>
			</activation>
			<properties>
				<test.args>-Doci:image=redis:latest -Doci:network-mode=host</test.args>
			</properties>
			<dependencies>
				<dependency>
					<groupId>io.lettuce</groupId>
					<artifactId>lettuce-core</artifactId>
				</dependency>
				<dependency>
					<groupId>org.springframework.session</groupId>
					<artifactId>spring-session-data-redis</artifactId>
				</dependency>
			</dependencies>
		</profile>
	</profiles>
</project>
