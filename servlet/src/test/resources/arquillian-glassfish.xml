<arquillian xmlns="http://jboss.org/schema/arquillian" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jboss.org/schema/arquillian https://jboss.org/schema/arquillian/arquillian_1_0.xsd">
	<extension qualifier="OCI">
		<property name="oci:image">ghcr.io/eclipse-ee4j/glassfish:latest</property>
		<property name="oci:network-mode">host</property>
		<property name="oci:start-message-pattern">.*\QSTART-SCRIPT-COMPLETE\E.*</property>
		<property name="oci:command">/opt/gfinstall/start.sh</property>
		<property name="env:DOMAIN_NAME">test-domain</property>
		<property name="env:CLUSTER_NAME">test</property>
		<property name="ref:SERVER_NAME"/>
		<property name="ref:ADMIN_HOST">adminHost</property>
		<property name="ref:ADMIN_PORT">adminPort</property>
		<property name="ref:ADMIN_USERNAME">adminUser</property>
		<property name="ref:ADMIN_PASSWORD">adminPassword</property>
		<property name="ref:DOMAIN_PORT_BASE">domainPortBase</property>
		<property name="ref:SERVER_PORT_BASE">serverPortBase</property>
		<property name="file:${project.basedir}/src/test/resources/${test.container}">/opt/gfinstall</property>
	</extension>
	<group qualifier="glassfish" default="true">
		<container qualifier="server-1" mode="manual">
			<configuration>
				<property name="domainPortBase">9000</property>
				<property name="serverPortBase">8000</property>
				<property name="adminHost">localhost</property>
				<property name="adminPort">9048</property>
				<property name="adminUser">admin</property>
				<property name="adminPassword">admin</property>
				<property name="authorisation">true</property>
				<property name="target">test</property>
				<property name="availabilityEnabled">true</property>
			</configuration>
		</container>
		<container qualifier="server-2" mode="manual">
			<configuration>
				<property name="domainPortBase">9100</property>
				<property name="serverPortBase">8100</property>
				<property name="adminHost">localhost</property>
				<property name="adminPort">9148</property>
				<property name="adminUser">admin</property>
				<property name="adminPassword">admin</property>
				<property name="authorisation">true</property>
				<property name="target">test</property>
				<property name="availabilityEnabled">true</property>
			</configuration>
		</container>
		<container qualifier="server-3" mode="manual">
			<configuration>
				<property name="domainPortBase">9200</property>
				<property name="serverPortBase">8200</property>
				<property name="adminHost">localhost</property>
				<property name="adminPort">9248</property>
				<property name="adminUser">admin</property>
				<property name="adminPassword">admin</property>
				<property name="authorisation">true</property>
				<property name="target">test</property>
				<property name="availabilityEnabled">true</property>
			</configuration>
		</container>
		<container qualifier="server-4" mode="manual">
			<configuration>
				<property name="domainPortBase">9300</property>
				<property name="serverPortBase">8300</property>
				<property name="adminHost">localhost</property>
				<property name="adminPort">9348</property>
				<property name="adminUser">admin</property>
				<property name="adminPassword">admin</property>
				<property name="authorisation">true</property>
				<property name="target">test</property>
				<property name="availabilityEnabled">true</property>
			</configuration>
		</container>
	</group>
</arquillian>
