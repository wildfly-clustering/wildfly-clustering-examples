<arquillian xmlns="http://jboss.org/schema/arquillian" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jboss.org/schema/arquillian https://jboss.org/schema/arquillian/arquillian_1_0.xsd">
	<extension qualifier="OCI">
		<property name="oci:image">tomcat:${test.container.version}</property>
		<property name="oci:host">localhost</property>
		<property name="oci:expose">bindHttpPort jmxPort shutdownPort</property>
		<property name="oci:start-message-pattern">.*\QServer startup in \E.*</property>
		<property name="ref:HTTP_PORT">bindHttpPort</property>
		<property name="ref:JMX_PORT">jmxPort</property>
		<property name="ref:SHUTDOWN_PORT">shutdownPort</property>
		<property name="env:JAVA_OPTS">-Dorg.apache.tomcat.util.digester.PROPERTY_SOURCE=org.apache.tomcat.util.digester.EnvironmentPropertySource -Djava.rmi.server.hostname=localhost -Dcom.sun.management.jmxremote.port=$JMX_PORT -Dcom.sun.management.jmxremote.rmi.port=$JMX_PORT -Dcom.sun.management.jmxremote.ssl=false -Dcom.sun.management.jmxremote.authenticate=false</property>
		<property name="file:${project.basedir}/src/test/resources/${test.container}">/usr/local/tomcat</property>
	</extension>
	<group qualifier="tomcat" default="true">
		<container qualifier="server-1" mode="manual">
			<configuration>
				<property name="bindHttpPort">8080</property>
				<property name="jmxPort">8089</property>
				<property name="shutdownPort">9089</property>
			</configuration>
		</container>
		<container qualifier="server-2" mode="manual">
			<configuration>
				<property name="bindHttpPort">8180</property>
				<property name="jmxPort">8189</property>
				<property name="shutdownPort">9189</property>
			</configuration>
		</container>
		<container qualifier="server-3" mode="manual">
			<configuration>
				<property name="bindHttpPort">8280</property>
				<property name="jmxPort">8289</property>
				<property name="shutdownPort">9289</property>
			</configuration>
		</container>
		<container qualifier="server-4" mode="manual">
			<configuration>
				<property name="bindHttpPort">8380</property>
				<property name="jmxPort">8389</property>
				<property name="shutdownPort">9389</property>
			</configuration>
		</container>
	</group>
</arquillian>
