<?xml version="1.0" encoding="UTF-8"?>
<payara-web-app>
	<session-config>
		<session-manager persistence-type="hazelcast">
			<manager-properties>
				<property name="disableJvmRoute" value="true"/>
				<property name="relaxCacheVersionSemantics" value="true"/>
			</manager-properties>
			<store-properties>
				<property name="persistenceScope" value="session"/>
			</store-properties>
		</session-manager>
	</session-config>
</payara-web-app>
