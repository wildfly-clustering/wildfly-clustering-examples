<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.wildfly.clustering.examples</groupId>
		<artifactId>wildfly-clustering-examples</artifactId>
		<version>42.0.0.Final-SNAPSHOT</version>
	</parent>

	<artifactId>wildfly-clustering-examples-mod_cluster</artifactId>
	<packaging>jar</packaging>

	<properties>
		<project.module.name>org.wildfly.clustering.examples.mod_cluster</project.module.name>
	</properties>

	<name>${project.repository.name}: mod_cluster</name>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.wildfly</groupId>
				<artifactId>wildfly-ejb-client-bom</artifactId>
				<version>41.0.1.Final</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.wildfly.clustering.benchmark</groupId>
				<artifactId>clusterbench-bom</artifactId>
				<version>18.0.1.Final</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>org.wildfly.clustering.benchmark</groupId>
			<artifactId>clusterbench-ee10-ear</artifactId>
			<!-- This artifact is missing from the bom!! -->
			<version>18.0.1.Final</version>
			<scope>provided</scope>
			<type>ear</type>
		</dependency>

		<dependency>
			<groupId>org.jboss</groupId>
			<artifactId>jboss-ejb-client</artifactId>
		</dependency>
		<dependency>
			<groupId>org.wildfly.clustering.benchmark</groupId>
			<artifactId>clusterbench-ee10-ejb</artifactId>
		</dependency>
		<dependency>
			<groupId>org.wildfly.wildfly-http-client</groupId>
			<artifactId>wildfly-http-ejb-client</artifactId>
		</dependency>
	</dependencies>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.codehaus.mojo</groupId>
					<artifactId>exec-maven-plugin</artifactId>
					<version>3.6.4</version>
				</plugin>
				<plugin>
					<groupId>org.wildfly.plugins</groupId>
					<artifactId>wildfly-maven-plugin</artifactId>
					<version>6.0.1.Final</version>
				</plugin>
			</plugins>
		</pluginManagement>

		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-deploy-plugin</artifactId>
				<executions>
					<execution>
						<id>default-deploy</id>
						<phase>none</phase>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.wildfly.plugins</groupId>
				<artifactId>wildfly-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>wildfly-deploy</id>
						<goals>
							<goal>deploy-artifact</goal>
						</goals>
						<phase>deploy</phase>
						<configuration>
							<groupId>org.wildfly.clustering.benchmark</groupId>
							<artifactId>clusterbench-ee10-ear</artifactId>
							<runtimeName>clusterbench-ee10.ear</runtimeName>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>default-cli</id>
						<goals>
							<goal>java</goal>
						</goals>
						<phase>none</phase>
						<configuration>
							<mainClass>org.wildfly.clustering.examples.mod_cluster.RemoteEJBClient</mainClass>
							<systemProperties>
								<projectProperties/>
							</systemProperties>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
